NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Server only (nunca en el cliente):
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
CRON_SECRET=generate_a_long_random_string_here

# Groq (gratis, recomendado para el Operador agentico):
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# Alternativa OpenAI (de pago):
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Solo dueño(s) — emails separados por coma:
ADMIN_EMAILS=tu@email.com
